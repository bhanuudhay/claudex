# Environment-only configuration: no config file needed.
#
# claudex builds one account per CLAUDE_TOKEN_<N>, in numeric order. This is the
# shape CI systems and secret managers hand you.
#
#   source examples/.env.example   # after filling in real tokens
#   claudex -p "say hi"

# Mint each token by logging in as that account and running `claude setup-token`.
CLAUDE_TOKEN_1=sk-ant-oat01-replace-me
CLAUDE_TOKEN_2=sk-ant-oat01-replace-me
CLAUDE_TOKEN_3=sk-ant-oat01-replace-me

# Optional: friendlier names and explicit ordering.
CLAUDEX_ACCOUNT_1_NAME=Personal
CLAUDEX_ACCOUNT_1_PRIORITY=1
CLAUDEX_ACCOUNT_2_NAME=Work
CLAUDEX_ACCOUNT_2_PRIORITY=2
CLAUDEX_ACCOUNT_3_NAME=Backup
CLAUDEX_ACCOUNT_3_PRIORITY=3

# Optional: maximum account switches per command (default 3).
CLAUDEX_MAX_SWITCHES=3

# Optional: path to the real Claude CLI, if it is not on PATH.
# CLAUDEX_CLAUDE_BIN=/Users/you/.local/bin/claude

# Optional: full debug logging (implies --cfo-debug).
# CLAUDEX_DEBUG=1
